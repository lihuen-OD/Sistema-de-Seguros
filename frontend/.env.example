# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001   # opcional (default: http://localhost:3001) — URL real del backend en demo/producción

# No hay ninguna otra variable VITE_* — el frontend nunca debe leer ni recibir secretos de
# ningún tipo (API keys, tokens, credenciales). Todo dato sensible vive solo en el backend.
