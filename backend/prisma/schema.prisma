generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fase 2 — Catálogos
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  cuit      String?  @unique
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assetAllocations     AssetAllocation[]
  policyAssetCoverages PolicyAssetCoverage[]

  @@index([isActive])
  @@map("companies")
}

model CostCenter {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetAllocations     AssetAllocation[]
  policyAssetCoverages PolicyAssetCoverage[]

  @@map("cost_centers")
}

model FixedAsset {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]

  @@map("fixed_assets")
}

model InsuranceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coverages            InsuranceCoverage[]
  policyAssetCoverages PolicyAssetCoverage[]

  @@map("insurance_types")
}

model InsuranceCoverage {
  id              String        @id @default(uuid())
  name            String
  description     String?
  insuranceTypeId String
  insuranceType   InsuranceType @relation(fields: [insuranceTypeId], references: [id], onDelete: Cascade)

  @@index([insuranceTypeId])
  @@map("insurance_coverages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fase 3 — Activos (forward references para que Company/CostCenter compilen)
// ─────────────────────────────────────────────────────────────────────────────

model Asset {
  id                     String    @id @default(uuid())
  code                   String?   @unique
  name                   String
  assetType              String
  status                 String    @default("activo")
  fixedAssetCode         String?
  fixedAssetId           String?
  brand                  String?
  model                  String?
  year                   Int?
  serialNumber           String?
  purchaseDate           DateTime? @db.Date
  dischargeDate          DateTime? @db.Date
  saleDate               DateTime? @db.Date
  purchaseValue          Float?
  currentValue           Float?
  patrimonialValueNew    Float?
  // Moneda en la que se cargan currentValue/patrimonialValueNew y su cierre en
  // ambas monedas — default USD porque los activos casi siempre se valúan en
  // dólares. exchangeRate es el tipo de cambio usado al cerrar este activo.
  currency               String    @default("USD")
  exchangeRate           Float     @default(1)
  currentValueArs        Float?
  currentValueUsd        Float?
  patrimonialValueNewArs Float?
  patrimonialValueNewUsd Float?
  location               String?
  mapsUrl                String?
  productiveUnit         String?
  area                   String?
  description            String?
  metadata               Json?
  isActive               Boolean   @default(true)
  // Dos flags ortogonales — cada uno gatea una auditoría distinta, un mismo
  // activo puede habilitarse para una y no para la otra. Junto con isActive
  // y la categoría (una de AUDITABLE_ASSET_CATEGORIES), definen el pool
  // elegible de cada módulo.
  // fireExtinguisherAuditable: Auditoría de Rodados — audita el
  // FireExtinguisher montado en este activo (ver fire-extinguisher-audits.population.ts).
  fireExtinguisherAuditable Boolean @default(false)
  // insuranceAuditable: Auditoría de Seguros — audita la tarjeta de
  // circulación de este activo (ver InsuranceAudit).
  insuranceAuditable        Boolean @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  allocations               AssetAllocation[]
  valueHistory              AssetValueHistory[]
  statusHistory             AssetStatusHistory[]
  attachments               AssetAttachment[]
  fireExtinguishers         FireExtinguisher[]
  claims                    Claim[]
  policyCoverages           PolicyAssetCoverage[]
  fixedAsset                 FixedAsset?                      @relation(fields: [fixedAssetId], references: [id])
  renewalProjectionOverrides AssetRenewalProjectionOverride[]
  insuranceAudits           InsuranceAudit[]

  @@index([isActive, status])
  @@index([isActive, assetType])
  @@index([name])
  @@index([brand])
  @@index([fixedAssetId])
  @@map("assets")
}

model AssetStatusHistory {
  id        String   @id @default(uuid())
  assetId   String
  status    String
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_status_history")
}

model AssetAllocation {
  id           String     @id @default(uuid())
  assetId      String
  companyId    String
  costCenterId String
  percentage   Float
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company      Company    @relation(fields: [companyId], references: [id])
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])

  @@index([assetId])
  @@index([companyId])
  @@index([costCenterId])
  @@map("asset_allocations")
}

model AssetValueHistory {
  id       String                @id @default(uuid())
  assetId  String
  value    Float
  // Cierre en ambas monedas de `value` al momento de este registro histórico
  // (mismo criterio que Asset.currentValueArs/Usd).
  valueArs Float?
  valueUsd Float?
  date     DateTime              @db.Date
  type     AssetValueHistoryType @default(real)
  note     String?
  asset    Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_value_history")
}

// Piloto de migración String→enum (ver CLAUDE.md §6) — valores en minúscula
// a propósito, igual que el String que reemplaza, para que ningún literal ya
// existente en el código de la aplicación (Zod, comparaciones, frontend)
// tenga que cambiar.
enum AssetValueHistoryType {
  real
  nuevo
}

// Compartido por los 7 modelos de adjuntos (AssetAttachment, InsuranceAuditAttachment,
// PolicyAttachment, DocumentAttachment, FireExtinguisherAttachment,
// ClaimExpenseAttachment, ClaimAttachment) — todos pasan por el mismo
// detectFileType() en shared/utils/files.ts, que nunca devuelve otro valor.
enum FileType {
  pdf
  image
  excel
  word
  video
  other
}

model AssetAttachment {
  id                 String    @id @default(uuid())
  assetId            String
  name               String
  description        String?
  fileType           FileType
  fileSize           String
  fileUrl            String
  cloudinaryPublicId String?
  expirationDate     DateTime? @db.Date
  uploadedAt         DateTime  @default(now())
  uploadedBy         String
  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([expirationDate])
  @@map("asset_attachments")
}

// Overrides editables de "Proyección de Renovaciones" — nunca toca
// Policy/AccountingDocument, solo guarda ajustes manuales por activo sobre
// una proyección calculada en el frontend a partir del historial real.
// null en cualquier campo = "usar el valor automático". Reset = borrar la fila.
// `mode` separa el override de la página de Financiero (cálculo por cuotas)
// del de Económico (cálculo por documento) — son números distintos por
// definición, así que un activo puede tener una fila independiente en cada modo.
model AssetRenewalProjectionOverride {
  id                    String   @id @default(uuid())
  assetId               String
  mode                  String
  netOverride           Float?
  vatOverride           Float?
  otherOverride         Float?
  // Escala 0-100, puede ser negativo (ej. -5 = -5% en cada renovación).
  growthPercentOverride Float?
  // Cada cuántos meses se repite la renovación proyectada (ambos modos) y
  // cuántas cuotas iguales la componen (solo tiene sentido en modo cuota —
  // Económico siempre es un pago único por documento, así que este campo
  // queda sin usar en esa página).
  cycleLengthMonthsOverride Int?
  installmentsCountOverride Int?
  // 'YYYY-MM' — pisa el mes de inicio detectado de la última renovación real
  // (el ancla que usa la proyección para calcular en qué mes cae cada pago
  // futuro). Útil para simular "esto lo doy de baja y arranco otro en X mes".
  startMonthOverride        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  asset                 Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, mode])
  @@map("asset_renewal_projection_overrides")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoría de Seguros — alcance por categoría de activo (UserAuditScope,
// área INSURANCE_AUDIT). El checklist real (confirmado con el negocio):
// comparar la tarjeta de circulación archivada en el sistema (subida al
// asegurar el activo, ver PolicyAttachment.isCirculationCard) contra la que
// debería estar físicamente en el vehículo — `hasCirculationCard` + fotos +
// comentario, nada más. Sin "InsuranceAuditProposedChange": este checklist
// no revisa/corrige datos maestros del activo ni de la póliza, así que no
// hay nada que proponer-y-aprobar.
//
// Nota: "Auditoría de Activos" (la contraparte de este modelo para
// condición física, no seguros) NO tiene un modelo propio — audita
// FireExtinguisher (los matafuegos montados en vehículos/maquinaria), no
// Asset, así que reutiliza FireExtinguisherAudit con `population: 'ASSET'`
// (ver fire-extinguisher-audits.population.ts). Este modelo (InsuranceAudit)
// es el único que sigue auditando el Asset directamente.
// ─────────────────────────────────────────────────────────────────────────────

model InsuranceAudit {
  id          String   @id @default(uuid())
  assetId     String
  status      String   @default("SUBMITTED") // DRAFT | SUBMITTED | APPROVED | REJECTED | NEEDS_CORRECTION
  auditDate   DateTime @db.Date // derivado en el server ("hoy"), nunca confiado del cliente
  auditPeriod String // "YYYY-MM", derivado en el server
  auditedBy   String

  // Checklist real (definido con el negocio): ¿la tarjeta de circulación
  // física está a bordo del vehículo? Se compara contra la tarjeta ya
  // archivada en el sistema (subida al asegurar el activo — ver
  // PolicyAttachment.isCirculationCard), que el wizard muestra como
  // referencia antes de tildar esto.
  hasCirculationCard Boolean @default(false)
  comments           String?

  // Seguimiento: el auditor "avisa" cuando coloca la tarjeta impresa en un
  // vehículo que había quedado marcado sin ella, y el revisor confirma desde
  // /:id/confirm-card-placed — funciona aunque la auditoría ya esté
  // APPROVED, a propósito (ver insurance-audits.service.ts). No reabre el
  // resto de la revisión ni cambia `status`.
  cardUpdateRequested   Boolean   @default(false)
  cardUpdateRequestedAt DateTime?
  cardUpdateRequestedBy String?

  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset       Asset                      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  attachments InsuranceAuditAttachment[]

  // La unicidad real de (assetId, auditPeriod) vive en un ÍNDICE ÚNICO
  // PARCIAL creado a mano en la migración de este modelo (WHERE status NOT
  // IN ('REJECTED','NEEDS_CORRECTION')) — mismo patrón que asset_audits y
  // fire_extinguisher_audits. Permite crear una auditoría nueva del mismo
  // activo+período tras una recorrección.
  // NO agregar @@unique([assetId, auditPeriod]) acá.
  // NO correr `prisma db push` contra esta tabla sin revisar a mano.
  @@index([assetId, auditPeriod])
  @@index([assetId])
  @@map("insurance_audits")
}

model InsuranceAuditAttachment {
  id                 String         @id @default(uuid())
  auditId            String
  name               String
  description        String?
  fileType           FileType
  fileSize           String
  fileUrl            String
  cloudinaryPublicId String?
  uploadedAt         DateTime       @default(now())
  uploadedBy         String

  audit InsuranceAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@map("insurance_audit_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fase 4 — Productores
// ─────────────────────────────────────────────────────────────────────────────

model Producer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  matricula String?  @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks    ProducerTask[]
  policies Policy[]

  @@map("producers")
}

model ProducerTask {
  id          String    @id @default(uuid())
  producerId  String
  title       String
  description String?
  dueDate     DateTime? @db.Date
  status      String    @default("pendiente")
  priority    String    @default("media")
  assignedTo  String?
  policyId    String?
  assetId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  producer    Producer  @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([producerId, status])
  @@index([dueDate, status])
  @@index([policyId])
  @@index([assetId])
  @@map("producer_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fase 5 — Pólizas
// ─────────────────────────────────────────────────────────────────────────────

// Una póliza guarda solo lo que es único de la póliza en sí — el resto
// (tipo de seguro, coberturas, suma asegurada/tipo de cambio, documentación)
// vive por línea en PolicyAssetCoverage, ya que una póliza puede cubrir
// varios activos y cada uno tiene sus propios datos.
model Policy {
  id            String    @id @default(uuid())
  policyNumber  String    @unique
  producerId    String?
  insuredName   String
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  description   String?
  isActive      Boolean   @default(true)
  // Solo el admin la setea (acción manual "Dar de baja") — nunca se calcula
  // automáticamente a partir de las fechas, a diferencia de vigente/próxima
  // a vencer/vencida (ver computePolicyStatus). Independiente de `isActive`,
  // que sigue usándose para el soft-delete de pólizas cargadas por error.
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  producer     Producer?             @relation(fields: [producerId], references: [id])
  coverages    PolicyAssetCoverage[]
  endorsements AccountingDocument[]
  claims       Claim[]

  @@index([isActive, endDate])
  @@index([producerId])
  @@map("policies")
}

// Línea de cobertura dentro de una póliza — una póliza puede tener varias
// (una por activo cubierto, o una o más "sin activo" para casos como
// Accidentes Personales). Cada línea tiene su propio tipo de seguro,
// coberturas, suma asegurada/tipo de cambio y documentación.
// companyId/costCenterId/beneficiaryDescription solo se usan cuando assetId
// es null — con activo, la imputación empresa/centro de costo ya vive en
// Asset.allocations.
model PolicyAssetCoverage {
  id                     String   @id @default(uuid())
  policyId               String
  assetId                String?
  insuranceTypeId        String
  coverageIds            String[]
  insuredAmount          Float    @default(0)
  currency               String   @default("ARS")
  exchangeRate           Float    @default(1)
  // Cierre de `insuredAmount` en ambas monedas al momento de guardar (ver
  // shared/utils/currency.ts#computeDualAmounts).
  insuredAmountArs       Float?
  insuredAmountUsd       Float?
  companyId              String?
  costCenterId           String?
  beneficiaryDescription String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  policy        Policy                     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  asset         Asset?                     @relation(fields: [assetId], references: [id])
  insuranceType InsuranceType              @relation(fields: [insuranceTypeId], references: [id])
  company       Company?                   @relation(fields: [companyId], references: [id])
  costCenter    CostCenter?                @relation(fields: [costCenterId], references: [id])
  attachments   PolicyAttachment[]
  allocations   DocumentPolicyAllocation[]

  // Evita que el mismo activo aparezca dos veces en la misma póliza. No
  // bloquea varias líneas "sin activo": Postgres trata cada NULL como
  // distinto en un unique constraint, así que (policyId, NULL) puede
  // repetirse todas las veces que haga falta.
  @@unique([policyId, assetId])
  @@index([policyId])
  @@index([assetId])
  @@index([insuranceTypeId])
  @@index([companyId])
  @@index([costCenterId])
  @@map("policy_asset_coverages")
}

model PolicyAttachment {
  id                    String              @id @default(uuid())
  policyAssetCoverageId String
  name                  String
  description           String?
  fileType              FileType
  fileSize              String
  fileUrl               String
  cloudinaryPublicId    String?
  isCirculationCard     Boolean             @default(false)
  uploadedAt            DateTime            @default(now())
  uploadedBy            String
  policyAssetCoverage   PolicyAssetCoverage @relation(fields: [policyAssetCoverageId], references: [id], onDelete: Cascade)

  @@index([policyAssetCoverageId])
  @@map("policy_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fase 6 — Documentos Contables
// ─────────────────────────────────────────────────────────────────────────────

model AccountingDocument {
  id               String   @id @default(uuid())
  documentNumber   String
  documentType     String
  documentStatus   String   @default("ISSUED")
  issueDate        DateTime @db.Date
  netAmount        Float
  vatAmount        Float    @default(0)
  otherTaxesAmount Float    @default(0)
  currency         String   @default("ARS")
  exchangeRate     Float    @default(1)
  // Cierre de (netAmount+vatAmount+otherTaxesAmount) en ambas monedas al
  // momento de guardar (ver shared/utils/currency.ts#computeDualAmounts).
  totalAmountArs   Float?
  totalAmountUsd   Float?
  description      String?
  paymentStatus    String   @default("PENDING")
  insuranceCompany String?
  paymentMethod    String?
  linkedDocumentId String?
  relationType     String?
  adjustmentReason String?
  adjustmentSign   String?

  // Fase 7 — Endoso: se asocia principalmente a una póliza, no a otro documento.
  policyId                 String?
  economicImpactType       String?
  endorsementType          String?
  endorsementEffectiveDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments           DocumentInstallment[]
  allocations            DocumentPolicyAllocation[]
  attachments            DocumentAttachment[]
  auditLogs              DocumentAuditLog[]
  policy                 Policy?                            @relation(fields: [policyId], references: [id])
  // Cuotas de OTRA factura que este documento (NC/ND/Ajuste) repartió al
  // aplicarse — ver InstallmentAdjustmentApplication.
  installmentAdjustments InstallmentAdjustmentApplication[] @relation("InstallmentAdjustmentSource")

  // El duplicado real es tipo + compañía + número (no el número solo — ver
  // documents.service.ts#create). Confirmado sin datos duplicados existentes
  // antes de agregar esta constraint. Nota: Postgres no exige unicidad entre
  // filas con insuranceCompany NULL (NULL != NULL), igual que ya asume el
  // chequeo previo a nivel de aplicación.
  @@unique([documentType, insuranceCompany, documentNumber])
  @@index([paymentStatus])
  @@index([issueDate])
  @@index([documentType])
  @@index([documentStatus])
  @@index([policyId])
  @@index([linkedDocumentId])
  @@map("accounting_documents")
}

model DocumentAuditLog {
  id                   String             @id @default(uuid())
  accountingDocumentId String
  action               String // CREATE | UPDATE | APPLY | CANCEL | PAYMENT_CHANGE
  description          String
  previousData         Json?
  newData              Json?
  performedBy          String?
  reason               String?
  createdAt            DateTime           @default(now())
  document             AccountingDocument @relation(fields: [accountingDocumentId], references: [id], onDelete: Cascade)

  @@index([accountingDocumentId])
  @@index([createdAt])
  @@map("document_audit_logs")
}

model DocumentInstallment {
  id                     String                             @id @default(uuid())
  accountingDocumentId   String
  installmentNumber      Int
  dueDate                DateTime                           @db.Date
  amount                 Float
  currency               String                             @default("ARS")
  // Cierre de `amount` en ambas monedas — se calcula al crear la cuota con el
  // tipo de cambio del documento padre, y se recalcula con un tipo de cambio
  // propio (pedido al usuario) al momento de marcarla como pagada.
  amountArs              Float?
  amountUsd              Float?
  paymentStatus          String                             @default("PENDING")
  paymentDate            DateTime?                          @db.Date
  paymentMethod          String?
  notes                  String?
  document               AccountingDocument                 @relation(fields: [accountingDocumentId], references: [id], onDelete: Cascade)
  adjustmentApplications InstallmentAdjustmentApplication[]

  @@index([accountingDocumentId])
  @@index([paymentStatus, dueDate])
  @@map("document_installments")
}

// Rastro de qué cuota se modificó y por cuánto al aplicar una Nota de
// Crédito/Débito/Ajuste contra su factura vinculada (ver
// documents.service.ts#apply). Append-only: si el documento origen se anula,
// se revierte exactamente este delta por cuota y se borran estas filas (el
// DocumentAuditLog de la anulación ya deja constancia del hecho).
model InstallmentAdjustmentApplication {
  id               String   @id @default(uuid())
  installmentId    String
  sourceDocumentId String
  deltaAmount      Float
  deltaAmountArs   Float
  deltaAmountUsd   Float
  createdAt        DateTime @default(now())

  installment    DocumentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  sourceDocument AccountingDocument  @relation("InstallmentAdjustmentSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@index([sourceDocumentId])
  @@map("installment_adjustment_applications")
}

// El nombre del modelo quedó de cuando apuntaba directo a Policy — hoy
// apunta a una línea (PolicyAssetCoverage), que ya sabe a qué póliza y a qué
// activo (o ninguno) pertenece. Ver policyAssetCoverageId.
model DocumentPolicyAllocation {
  id                    String              @id @default(uuid())
  accountingDocumentId  String
  policyAssetCoverageId String
  allocatedAmount       Float
  allocationPercentage  Float
  document              AccountingDocument  @relation(fields: [accountingDocumentId], references: [id], onDelete: Cascade)
  policyAssetCoverage   PolicyAssetCoverage @relation(fields: [policyAssetCoverageId], references: [id])

  @@index([accountingDocumentId])
  @@index([policyAssetCoverageId])
  @@map("document_policy_allocations")
}

model DocumentAttachment {
  id                   String             @id @default(uuid())
  accountingDocumentId String
  name                 String
  description          String?
  fileType             FileType
  fileSize             String
  fileUrl              String
  cloudinaryPublicId   String?
  uploadedAt           DateTime           @default(now())
  uploadedBy           String
  document             AccountingDocument @relation(fields: [accountingDocumentId], references: [id], onDelete: Cascade)

  @@index([accountingDocumentId])
  @@map("document_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fase 7 — Matafuegos
// ─────────────────────────────────────────────────────────────────────────────

model FireExtinguisher {
  id                          String    @id @default(uuid())
  code                        String    @unique
  assetId                     String?
  locationType                String
  location                    String?
  establishment               String?
  type                        String
  capacity                    String
  brand                       String?
  cylinderNumber              String?
  iramCertificateNumber       String?
  manufacturingYear           Int?
  expirationDate              DateTime? @db.Date
  lastRechargeDate            DateTime? @db.Date
  hydraulicTestExpirationDate DateTime? @db.Date
  observations                String?
  isActive                    Boolean   @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  asset           Asset?                                @relation(fields: [assetId], references: [id])
  history         FireExtinguisherHistory[]
  audits          FireExtinguisherAudit[]
  proposedChanges FireExtinguisherAuditProposedChange[]
  attachments     FireExtinguisherAttachment[]

  @@index([isActive, expirationDate])
  @@index([assetId])
  @@map("fire_extinguishers")
}

// nextDueDate/previousExpirationDate: columnas específicas de recarga (sin cambios).
// description/previousData/newData: diff genérico usado por altas/ediciones/bajas.
// Ambas formas conviven en la misma tabla — un timeline único por matafuego.
model FireExtinguisherHistory {
  id                     String           @id @default(uuid())
  fireExtinguisherId     String
  action                 String
  date                   DateTime         @db.Date
  performedBy            String?
  notes                  String?
  nextDueDate            DateTime?        @db.Date
  previousExpirationDate DateTime?        @db.Date
  description            String?
  previousData           Json?
  newData                Json?
  createdAt              DateTime         @default(now())
  extinguisher           FireExtinguisher @relation(fields: [fireExtinguisherId], references: [id], onDelete: Cascade)

  @@index([fireExtinguisherId])
  @@index([createdAt])
  @@map("fire_extinguisher_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Matafuegos Fase 3 — Auditoría mensual
//
// El maestro (FireExtinguisher) es la verdad oficial. Una auditoría NUNCA
// modifica el maestro directamente — cualquier discrepancia detectada por el
// auditor (ubicación o campos de FireExtinguisherAuditProposedChange) queda
// en estado PENDING hasta que una fase futura (revisión/aprobación) la aplique.
//
// Este mismo modelo sirve para DOS poblaciones de FireExtinguisher, nunca
// mezcladas en una consulta: matafuegos de edificio ("Auditoría de
// Matafuegos", alcance por establecimiento) y matafuegos montados en un
// vehículo/maquinaria ("Auditoría de Activos", alcance por categoría de
// activo). La población nunca se guarda en una columna — se deriva siempre
// de `extinguisher.assetId` + `classifyAssetType()` (ver
// fire-extinguisher-audits.population.ts). `mountingCondition` es el único
// campo del checklist cuyo RÓTULO cambia según la población ("Chapa Baliza"
// en un edificio, "Soporte / Abrazadera" en un vehículo) — mismos 4 valores
// en ambos casos.
// ─────────────────────────────────────────────────────────────────────────────

model FireExtinguisherAudit {
  id                 String   @id @default(uuid())
  fireExtinguisherId String
  status             String   @default("SUBMITTED") // DRAFT | SUBMITTED | APPROVED | REJECTED | NEEDS_CORRECTION
  auditDate          DateTime @db.Date // derivado en el server ("hoy"), nunca confiado del cliente
  auditPeriod        String // "YYYY-MM", derivado en el server
  auditedBy          String

  // Paso 2 — Validación de ubicación
  locationConfirmed       Boolean @default(true)
  locationChangeRequested Boolean @default(false)
  proposedLocation        String?
  locationChangeReason    String?

  // Paso 4 — Checklist de condición (embebido, sin tabla separada)
  cleanliness                  String
  chargeFillStatus             String // CARGADO | DESCARGADO — no confundir con el status de vencimiento (vigente/proximo_vencer/vencido)
  mountingCondition            String // SANA | ROTA_LEVE | ROTA_REQUIERE_CAMBIO | NO_TIENE — "Chapa Baliza" (edificio) o "Soporte/Abrazadera" (vehículo), ver comentario del modelo
  sealStatus                   String
  ringStatus                   String
  hoseNozzleCondition          String
  chargeExpirationDateObserved DateTime? @db.Date
  comments                     String?

  // Fase 4 — Revisión/aprobación
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extinguisher    FireExtinguisher                      @relation(fields: [fireExtinguisherId], references: [id], onDelete: Cascade)
  proposedChanges FireExtinguisherAuditProposedChange[]
  attachments     FireExtinguisherAttachment[]

  // La unicidad real de (fireExtinguisherId, auditPeriod) NO se modela acá con
  // @@unique — vive en un ÍNDICE ÚNICO PARCIAL creado a mano en la migración
  // 20260707120000_add_fire_extinguisher_audit_review (WHERE status NOT IN
  // ('REJECTED','NEEDS_CORRECTION')), para permitir crear una auditoría nueva
  // del mismo matafuego+período tras una recorrección. Prisma no soporta
  // partial indexes en su DSL — por eso es invisible acá. Mismo patrón que
  // 20260622000003_add_sequential_sequences (SEQUENCEs de Postgres).
  // NO reintroducir @@unique([fireExtinguisherId, auditPeriod]) acá.
  // NO correr `prisma db push` contra esta tabla sin revisar a mano.
  @@index([fireExtinguisherId, auditPeriod])
  @@index([fireExtinguisherId])
  @@map("fire_extinguisher_audits")
}

model FireExtinguisherAuditProposedChange {
  id                 String   @id @default(uuid())
  auditId            String
  fireExtinguisherId String // denormalizado — permite consultar cambios pendientes de una unidad sin pasar por el audit
  fieldName          String // coincide 1:1 con la columna real del maestro: cylinderNumber | expirationDate | capacity | type | brand | location
  currentValue       String
  proposedValue      String
  reason             String?
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  audit        FireExtinguisherAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  extinguisher FireExtinguisher      @relation(fields: [fireExtinguisherId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([fireExtinguisherId])
  @@map("fire_extinguisher_audit_proposed_changes")
}

model FireExtinguisherAttachment {
  id                 String   @id @default(uuid())
  fireExtinguisherId String
  auditId            String?
  name               String
  description        String?
  fileType           FileType
  fileSize           String
  fileUrl            String
  cloudinaryPublicId String?
  uploadedAt         DateTime @default(now())
  uploadedBy         String

  extinguisher FireExtinguisher       @relation(fields: [fireExtinguisherId], references: [id], onDelete: Cascade)
  audit        FireExtinguisherAudit? @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@index([fireExtinguisherId])
  @@index([auditId])
  @@map("fire_extinguisher_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fase 8 — Siniestros
// ─────────────────────────────────────────────────────────────────────────────

model Claim {
  id                         String   @id @default(uuid())
  claimNumber                String   @unique
  title                      String?
  assetId                    String?
  policyId                   String?
  claimType                  String
  occurrenceDate             DateTime @db.Date
  reportDate                 DateTime @db.Date
  description                String?
  insuranceCompany           String?
  ownershipType              String   @default("propio")
  responsiblePersonName      String?
  thirdPartyInsuranceCompany String?
  thirdPartyContact          String?
  thirdPartyInsurerContact   String?
  status                     String   @default("denunciado")
  // El sufijo "Ars" es histórico — a partir de esta feature ambos campos
  // (Ars/Usd) siempre se calculan server-side con computeDualAmounts, sin
  // importar en qué moneda se haya cargado el monto original.
  claimedAmountArs           Float    @default(0)
  claimedAmountUsd           Float?
  realAmountArs              Float?
  realAmountUsd              Float?
  settledAmountArs           Float?
  settledAmountUsd           Float?
  deductibleArs              Float?
  deductibleUsd              Float?
  currency                   String   @default("ARS")
  exchangeRate               Float    @default(1)
  observations               String?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  asset       Asset?            @relation(fields: [assetId], references: [id])
  policy      Policy?           @relation(fields: [policyId], references: [id])
  events      ClaimEvent[]
  attachments ClaimAttachment[]
  expenses    ClaimExpense[]

  @@index([isActive, status])
  @@index([isActive, occurrenceDate])
  @@index([policyId])
  @@index([assetId])
  @@index([occurrenceDate])
  @@map("claims")
}

model ClaimExpense {
  id               String                   @id @default(uuid())
  claimId          String
  date             DateTime                 @db.Date
  provider         String
  receiptNumber    String?
  netAmount        Float
  vatAmount        Float                    @default(0)
  otherTaxesAmount Float                    @default(0)
  comment          String?
  createdAt        DateTime                 @default(now())
  createdBy        String?
  claim            Claim                    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  attachments      ClaimExpenseAttachment[]

  @@index([claimId])
  @@map("claim_expenses")
}

model ClaimExpenseAttachment {
  id                 String       @id @default(uuid())
  expenseId          String
  name               String
  description        String?
  fileType           FileType
  fileSize           String
  fileUrl            String
  cloudinaryPublicId String?
  uploadedAt         DateTime     @default(now())
  uploadedBy         String
  expense            ClaimExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("claim_expense_attachments")
}

model ClaimAttachment {
  id                 String   @id @default(uuid())
  claimId            String
  name               String
  description        String?
  fileType           FileType
  fileSize           String
  fileUrl            String
  cloudinaryPublicId String?
  uploadedAt         DateTime @default(now())
  uploadedBy         String
  claim              Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_attachments")
}

model ClaimEvent {
  id             String   @id @default(uuid())
  claimId        String
  type           String
  description    String
  date           DateTime @db.Date
  previousStatus String?
  newStatus      String?
  amountLabel    String?
  previousAmount Float?
  newAmount      Float?
  createdBy      String?
  createdAt      DateTime @default(now())
  claim          Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuración de Módulos — Catálogos dinámicos
// ─────────────────────────────────────────────────────────────────────────────

model CatalogItem {
  id        String   @id @default(uuid())
  category  String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, label])
  @@index([category])
  @@map("catalog_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tipo de Cambio Global
// ─────────────────────────────────────────────────────────────────────────────

// Log append-only: "actual" = la fila más reciente por createdAt. Sin FK a
// User (mismo criterio que UserAuditLog/DocumentAuditLog) para que el
// historial sobreviva aunque se borre el usuario que lo actualizó.
model ExchangeRateLog {
  id        String   @id @default(uuid())
  rate      Float // 1 USD = `rate` ARS
  updatedBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("exchange_rate_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Email — Envío transaccional (Resend)
// ─────────────────────────────────────────────────────────────────────────────

model EmailLog {
  id       String @id @default(uuid())
  type     String // MANUAL_DOCUMENT_SEND | EXPIRATION_SUMMARY | ATTACHMENT_EXPIRATION | POLICY_EXPIRATION | FIRE_EXTINGUISHER_EXPIRATION | WORKFLOW_NOTIFICATION | SYSTEM
  status   String @default("PENDING") // PENDING | SENT | FAILED | SKIPPED | CANCELLED
  provider String @default("resend")

  fromAddress  String
  toAddresses  String[]
  ccAddresses  String[] @default([])
  bccAddresses String[] @default([])
  replyTo      String?
  subject      String

  // Referencia polimórfica suelta — un mismo log puede apuntar a distintas
  // tablas (AccountingDocument, Policy, FireExtinguisher, etc.), por eso no
  // hay FK real, solo entityType + entityId.
  entityType String?
  entityId   String?

  triggeredByUserId String?
  triggeredByEmail  String?

  scheduledFor DateTime?
  sentAt       DateTime?
  failedAt     DateTime?
  errorMessage String?

  providerMessageId String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([type, status])
  @@index([createdAt])
  @@map("email_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Autenticación — usuarios propios (reemplaza el auto-login de desarrollo)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  accessProfileId    String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  // Se incrementa al cambiar/resetear la contraseña — el JWT lleva el valor
  // vigente al momento de firmarse, y authMiddleware lo compara contra este
  // campo para invalidar cualquier token emitido antes del cambio.
  tokenVersion       Int       @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accessProfile AccessProfile?          @relation(fields: [accessProfileId], references: [id])
  dismissals    NotificationDismissal[]
  auditScopes   UserAuditScope[]

  @@index([role])
  @@index([accessProfileId])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// Alcance de auditoría — qué establecimientos (matafuegos) o categorías de
// activo (activos/seguros) puede ver/operar un usuario auditor puntual.
//
// Muchos-a-muchos real: un mismo (area, scopeValue) puede estar asignado a más
// de un usuario (ej. un auditor de respaldo) — la unicidad es sobre la TERNA
// (userId, area, scopeValue), no sobre (area, scopeValue) solo.
//
// NO es un permiso de módulo (eso lo sigue resolviendo AccessProfile.modules
// vía requireModule) — es un filtro de "cuáles" recursos dentro de un módulo
// ya habilitado. Un usuario auditor sin ninguna fila para su área ve una
// pantalla vacía, no un error (ver resolveAuditScope). Los revisores y el
// ADMIN nunca se restringen por esta tabla.
model UserAuditScope {
  id         String   @id @default(uuid())
  userId     String
  area       String // FIRE_EXTINGUISHER_AUDIT | ASSET_AUDIT | INSURANCE_AUDIT
  // FIRE_EXTINGUISHER_AUDIT: label de CatalogItem(category:'fire_ext_establishment'),
  //   texto libre igual que FireExtinguisher.establishment — sin FK real, mismo
  //   criterio que el resto del catálogo de establecimientos.
  // ASSET_AUDIT / INSURANCE_AUDIT: una de AUDITABLE_ASSET_CATEGORIES (lista fija
  //   del backend, espejo de AssetCategory del frontend).
  scopeValue String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area, scopeValue])
  @@index([userId, area])
  @@index([area, scopeValue])
  @@map("user_audit_scopes")
}

// Feed de comentarios compartido por las 3 auditorías (Matafuegos, Rodados,
// Seguros) — vive en Cobertura, visible para auditor y admin. Se alimenta
// solo (nota del auditor al auditar/editar, decisión del revisor al
// aprobar/rechazar/pedir corrección) y también admite un comentario suelto
// sin auditoría de por medio (botón "Agregar comentario"). Sin FK real a
// propósito — mismo criterio que UserAuditScope.scopeValue: la tabla es
// genérica entre poblaciones, `targetId` es un fireExtinguisherId o un
// assetId según `targetType`, nunca ambos a la vez.
model AuditComment {
  id          String   @id @default(uuid())
  targetType  String // FIRE_EXTINGUISHER (Matafuegos+Rodados, targetId = fireExtinguisherId) | ASSET (Seguros, targetId = assetId)
  targetId    String
  auditPeriod String // "YYYY-MM" — mismo criterio de período que el resto de Cobertura
  auditId     String? // fila de origen (fire_extinguisher_audits/insurance_audits) si vino de un checklist/revisión — null si es un comentario suelto
  source      String // AUDITOR_NOTE | REVIEW_DECISION | MANUAL
  auditStatus String? // snapshot de la decisión (APPROVED/REJECTED/NEEDS_CORRECTION) — solo en REVIEW_DECISION, para el badge en la UI
  body        String
  authorEmail String
  seenAt      DateTime?
  seenByEmail String?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId, auditPeriod])
  @@map("audit_comments")
}

// Sin relación formal a User a propósito: un audit log debe sobrevivir aunque
// el usuario referenciado se borre en el futuro (hoy no hay DELETE de
// usuarios, pero no queremos que este log dependa de que eso siga así).
model UserAuditLog {
  id           String   @id @default(uuid())
  targetUserId String
  action       String // CREATE | UPDATE | RESET_PASSWORD
  previousData Json?
  newData      Json?
  performedBy  String?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([createdAt])
  @@map("user_audit_logs")
}

// Perfil de acceso reutilizable: el ADMIN lo crea con un nombre y una lista
// de módulos (pantallas) habilitados; varios usuarios pueden compartir un
// mismo perfil. Editar `modules` acá afecta a todos sus usuarios de inmediato
// (se resuelve fresco en cada request, no viaja cacheado en el JWT).
model AccessProfile {
  id        String   @id @default(uuid())
  name      String   @unique
  modules   String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("access_profiles")
}

// Notificaciones calculadas en vivo (sin tabla propia) — esto guarda solo
// el "ya lo vi" de cada usuario. La clave incluye dueDate a propósito: si
// el vencimiento real cambia (ej. se renueva una póliza), el descarte viejo
// deja de aplicar y la alerta vuelve a aparecer sin limpiar nada a mano.
model NotificationDismissal {
  id             String   @id @default(uuid())
  userId         String
  notificationId String
  dueDate        String
  dismissedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId, dueDate])
  @@index([userId])
  @@map("notification_dismissals")
}
